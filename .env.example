# Firebase project used by the Cloudvalt app.
FIREBASE_PROJECT_ID="strange-bird-467010-q9"
FIRESTORE_DATABASE_ID="ai-studio-remixremixcloudv-42a2b61a-2d55-4ff5-9eec-86f128500033"

# Comma-separated Firebase Auth UIDs allowed to use the admin dashboard.
# Set this in the server's private environment, never in a VITE_ variable.
ADMIN_UIDS="your-firebase-admin-uid"

# Optional for local development. On Cloud Run, prefer the service's attached
# Google service account with Firestore read access instead of a JSON key.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'

# Public Firebase web configuration used by the sign-in screen.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="strange-bird-467010-q9.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="strange-bird-467010-q9"
VITE_FIREBASE_STORAGE_BUCKET="strange-bird-467010-q9.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="71375570323"
VITE_FIREBASE_APP_ID="1:71375570323:web:70e7bc23622ef9cfdf1466"
